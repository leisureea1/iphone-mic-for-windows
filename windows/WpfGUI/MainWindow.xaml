<Window x:Class="iPhoneMic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iPhone 麦克风控制中心" Height="450" Width="400"
        Background="#1E1E1E" Foreground="White"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei, Segoe UI">
    <Window.Resources>
        <!-- Modern Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#444444"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#222222"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title & Status -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="iPhoneMic 控制中心" FontSize="24" FontWeight="Bold" Foreground="#EEEEEE"/>
            <Border Margin="15,0,0,0" VerticalAlignment="Center" Padding="8,4" CornerRadius="12" Name="StatusBorder" Background="#555555">
                <TextBlock Name="StatusText" Text="未连接" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
            </Border>
        </StackPanel>

        <!-- Output Device Routing -->
        <TextBlock Grid.Row="1" Text="ASIO 输出设备路由" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,5" Foreground="#BBBBBB"/>
        <TextBlock Grid.Row="2" Text="选择 DAW 音频应该输出到哪个设备 (需要重启 DAW):" FontSize="12" Foreground="#888888" Margin="0,0,0,10"/>
        
        <Grid Grid.Row="3" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" Name="DeviceComboBox" Margin="0,0,10,0" VerticalAlignment="Center" SelectionChanged="DeviceComboBox_SelectionChanged"/>
            <Button Grid.Column="1" Content="刷新设备" Click="RefreshButton_Click"/>
        </Grid>

        <!-- Audio Monitoring -->
        <TextBlock Grid.Row="4" Text="实时监听" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,5" Foreground="#BBBBBB"/>
        
        <StackPanel Grid.Row="5" Margin="0,10,0,0">
            <CheckBox Name="MonitorCheckBox" Content="监听麦克风 (听取 iPhone 麦克风的声音)" Foreground="White" FontSize="14" Checked="MonitorCheckBox_Checked" Unchecked="MonitorCheckBox_Unchecked"/>
            
            <TextBlock Text="⚠️ 注意：在 DAW 中录音时请关闭监听，否则会导致回声或机器音。" FontSize="11" Foreground="#FFAA00" Margin="0,5,0,20"/>
            
            <!-- VU Meter -->
            <TextBlock Text="麦克风输入电平" FontSize="12" Foreground="#888888" Margin="0,0,0,5"/>
            <Grid Height="12" Margin="0,0,0,5">
                <ProgressBar Name="LevelMeterL" Minimum="0" Maximum="1" Value="0" Foreground="#00FF00" Background="#222222" BorderThickness="0"/>
            </Grid>
            <Grid Height="12">
                <ProgressBar Name="LevelMeterR" Minimum="0" Maximum="1" Value="0" Foreground="#00FF00" Background="#222222" BorderThickness="0"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
